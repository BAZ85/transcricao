# Provedor de IA usado para corrigir os termos técnicos da transcrição.
# Valores aceitos: openai (padrão), gemini, claude.
# Preencha a chave de API correspondente ao provedor escolhido abaixo.
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
# Opcional: se sua conta não tiver acesso ao modelo padrão definido em config.py,
# informe aqui um que você tenha acesso (ex.: gpt-4o-mini).
OPENAI_MODEL=

# --- Google Gemini ---
GEMINI_API_KEY=
# Opcional: modelo Gemini a usar (padrão: gemini-2.5-flash).
GEMINI_MODEL=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
# Opcional: modelo Claude a usar (padrão: claude-sonnet-5).
ANTHROPIC_MODEL=

# Copie este arquivo para .env e preencha os valores reais. Nunca versione o .env.
