# Chave de API da OpenAI, usada pelo componente corretor de termos técnicos
# para corrigir termos técnicos da disciplina identificada na transcrição.
# Copie este arquivo para .env e preencha o valor real. Nunca versione o .env.
OPENAI_API_KEY=

# Opcional: modelo da OpenAI usado na correção de termos. Se sua conta não tiver
# acesso ao modelo padrão definido em config.py, informe aqui um que você tenha
# acesso (ex.: gpt-4o-mini).
OPENAI_MODEL=
