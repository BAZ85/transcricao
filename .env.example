# Provedor de IA usado para corrigir os termos técnicos da transcrição.
# Valores aceitos: openai (padrão), claude.
# Preencha a chave de API correspondente ao provedor escolhido abaixo.
AI_PROVIDER=openai

# --- OpenAI (e qualquer API compatível: DeepSeek, Qwen, Grok, etc.) ---
OPENAI_API_KEY=
# Opcional: se sua conta não tiver acesso ao modelo padrão definido em config.py,
# informe aqui um que você tenha acesso (ex.: gpt-4o-mini), ou o modelo de outro
# provedor compatível (ex.: deepseek-chat) — veja "Usando outros modelos" no README.
OPENAI_MODEL=
# Opcional: endpoint alternativo compatível com a API da OpenAI. Deixe em branco
# para usar a OpenAI oficial. Veja "Usando outros modelos" no README.
OPENAI_BASE_URL=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
# Opcional: modelo Claude a usar (padrão: claude-sonnet-5).
ANTHROPIC_MODEL=

# Copie este arquivo para .env e preencha os valores reais. Nunca versione o .env.
